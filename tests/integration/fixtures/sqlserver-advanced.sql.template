CREATE TABLE dbo.partitioned_data(id int NOT NULL,value varchar(20)) ON cb_scheme(id);
CREATE INDEX ix_partitioned ON dbo.partitioned_data(id) WITH(DATA_COMPRESSION=PAGE) ON cb_scheme(id);
