CREATE TABLE dbo.temporal_data(id int PRIMARY KEY,value nvarchar(60), valid_from datetime2 GENERATED ALWAYS AS ROW START NOT NULL,valid_to datetime2 GENERATED ALWAYS AS ROW END NOT NULL,PERIOD FOR SYSTEM_TIME(valid_from,valid_to)) WITH (SYSTEM_VERSIONING=ON(HISTORY_TABLE=dbo.temporal_history));
