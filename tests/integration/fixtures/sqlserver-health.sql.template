-- Select a NEW disposable database explicitly before running. SQL Server 2022 Developer tested.
CREATE TABLE dbo.health_fixture(id int NOT NULL PRIMARY KEY,payload char(1000));
WITH n AS (SELECT TOP (12000) ROW_NUMBER() OVER(ORDER BY (SELECT NULL)) AS i FROM sys.all_objects a CROSS JOIN sys.all_objects b)
INSERT dbo.health_fixture SELECT i,REPLICATE('x',1000) FROM n;
DELETE dbo.health_fixture WHERE id%2=0;
CREATE TABLE dbo.columnstore_fixture(id int,value int);
CREATE CLUSTERED COLUMNSTORE INDEX cci ON dbo.columnstore_fixture;
INSERT dbo.columnstore_fixture SELECT id,id FROM dbo.health_fixture;
-- Collect with -IncludeHealthMetrics -IncludeIndexHealth, then drop the disposable DB.
